<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#173c35">
<title>همراه وزن من</title>
<style>
:root{--green:#173c35;--mint:#dcefe6;--cream:#f7f5ef;--ink:#1f2925;--muted:#68736e;--line:#e2e6e1;--white:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,sans-serif;line-height:1.6}
header{background:var(--green);color:white;padding:26px 20px 30px;border-radius:0 0 26px 26px}header .tag{font-size:12px;opacity:.8}h1{margin:5px 0;font-size:27px}header p{margin:0;opacity:.9;font-size:14px}
main{max-width:760px;margin:auto;padding:16px}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:-4px}
.card,.panel{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 4px 16px #183c3510}
.label{color:var(--muted);font-size:13px}.value{font-size:25px;font-weight:750;margin-top:3px}.unit{font-size:13px;color:var(--muted);font-weight:400}
.panel{margin-top:14px}.panel h2{font-size:18px;margin:0 0 12px}
form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}label{font-size:13px;color:var(--muted)}
input,textarea{font:inherit;font-size:16px;border:1px solid #d7ded8;border-radius:11px;padding:10px 12px;width:100%;background:#fff;color:var(--ink)}
textarea{min-height:70px;resize:vertical}
button{font:inherit;font-weight:650;border:0;border-radius:12px;padding:12px 16px;cursor:pointer}
.primary{background:var(--green);color:#fff}.secondary{background:var(--mint);color:var(--green)}.danger{background:#f9e8e5;color:#9d3428}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.chart-wrap{width:100%;overflow:hidden}svg{width:100%;height:auto;display:block}
.history{display:flex;flex-direction:column;gap:8px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid var(--line);padding:9px 0}.row:last-child{border-bottom:0}.row small{color:var(--muted)}
.note{font-size:12px;color:var(--muted);margin-top:10px}.empty{color:var(--muted);font-size:14px;padding:12px 0}
footer{text-align:center;color:var(--muted);font-size:12px;padding:22px}
@media(min-width:600px){.cards{grid-template-columns:repeat(4,minmax(0,1fr))}.value{font-size:23px}}
</style>
</head>
<body>
<header>
  <div class="tag">نسخه آزمایشی · رایگان</div>
  <h1>همراه وزن من 🌿</h1>
  <p>ثبت روزانه، دیدن روند و ساخت عادت‌های پایدار</p>
</header>
<main>
  <section class="cards">
    <div class="card"><div class="label">آخرین وزن</div><div class="value" id="latest">— <span class="unit">کیلوگرم</span></div></div>
    <div class="card"><div class="label">تغییر نسبت به ثبت قبلی</div><div class="value" id="change">—</div></div>
    <div class="card"><div class="label">ثبت‌های وزن</div><div class="value" id="count">۰</div></div>
    <div class="card"><div class="label">کالری امروز</div><div class="value" id="calories">۰ <span class="unit">کیلوکالری</span></div></div>
  </section>

  <section class="panel">
    <h2>ثبت امروز</h2>
    <form id="entryForm">
      <div class="field"><label for="date">تاریخ</label><input id="date" type="date" required></div>
      <div class="field"><label for="weight">وزن (کیلوگرم)</label><input id="weight" type="number" min="20" max="350" step="0.1" placeholder="مثلاً ۸۷٫۵"></div>
      <div class="field"><label for="food">شرح غذا / وعده</label><input id="food" type="text" placeholder="مثلاً ناهار"></div>
      <div class="field"><label for="foodCalories">کالری تقریبی غذا</label><input id="foodCalories" type="number" min="0" max="10000" step="1" placeholder="مثلاً ۶۰۰"></div>
      <div class="field"><label for="activity">فعالیت بدنی (دقیقه)</label><input id="activity" type="number" min="0" max="1440" step="1" placeholder="مثلاً ۴۵"></div>
      <div class="field"><label for="water">آب نوشیده‌شده (لیوان)</label><input id="water" type="number" min="0" max="50" step="1" placeholder="مثلاً ۸"></div>
      <div class="field full"><label for="notes">یادداشت (اختیاری)</label><textarea id="notes" placeholder="حس‌وحال، خواب یا نکته‌ای که می‌خواهی ثبت کنی"></textarea></div>
      <div class="field full"><button class="primary" type="submit">ذخیره اطلاعات این روز</button></div>
    </form>
    <p class="note">اگر وزن را وارد نکنی، می‌توانی فقط غذا یا فعالیت را ثبت کنی. اطلاعات این نسخه روی همین مرورگر ذخیره می‌شود.</p>
  </section>

  <section class="panel">
    <h2>روند تغییرات وزن</h2>
    <div class="chart-wrap" id="chart"><div class="empty">برای نمایش نمودار، دست‌کم دو بار وزن ثبت کن.</div></div>
  </section>

  <section class="panel">
    <h2>سوابق اخیر</h2>
    <div id="history" class="history"><div class="empty">هنوز اطلاعاتی ثبت نشده است.</div></div>
    <div class="actions">
      <button class="secondary" id="exportBtn" type="button">خروجی گرفتن از اطلاعات (JSON)</button>
      <button class="danger" id="clearBtn" type="button">پاک‌کردن همه اطلاعات</button>
    </div>
  </section>
  <footer>این ابزار برای پیگیری عادت‌هاست و جایگزین توصیه پزشکی نیست. کالری‌ها تقریبی‌اند.</footer>
</main>
<script>
const $=id=>document.getElementById(id);
const KEY='hamrah-vazn-v1';
let entries=load();
function load(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return []}}
function save(){localStorage.setItem(KEY,JSON.stringify(entries))}
function today(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
$('date').value=today();
const fa=n=>Number(n).toLocaleString('fa-IR',{maximumFractionDigits:1});
function render(){
 const sorted=[...entries].sort((a,b)=>a.date.localeCompare(b.date));
 const weighed=sorted.filter(e=>Number.isFinite(e.weight)&&e.weight>0);
 const latest=weighed.at(-1),prev=weighed.at(-2);
 $('latest').innerHTML=latest?`${fa(latest.weight)} <span class="unit">کیلوگرم</span>`:'— <span class="unit">کیلوگرم</span>';
 $('change').textContent=latest&&prev?`${Number(latest.weight-prev.weight)>0?'+':''}${fa(latest.weight-prev.weight)} کیلوگرم`:'—';
 $('count').textContent=fa(weighed.length);
 const todayEntry=sorted.find(e=>e.date===today());
 $('calories').innerHTML=`${fa(todayEntry?.calories||0)} <span class="unit">کیلوکالری</span>`;
 renderChart(weighed);
 const recent=[...sorted].reverse().slice(0,7);
 $('history').innerHTML=recent.length?recent.map(e=>`<div class="row"><div><strong>${escapeHtml(e.date)}</strong><br><small>${escapeHtml(e.food||e.notes||'بدون یادداشت')} · فعالیت: ${fa(e.activity||0)} دقیقه</small></div><div style="text-align:left"><strong>${e.weight?fa(e.weight)+' kg':'—'}</strong><br><small>${fa(e.calories||0)} کالری</small></div><button class="danger" style="padding:7px 10px" onclick="removeEntry('${e.date}')">حذف</button></div>`).join(''):'<div class="empty">هنوز اطلاعاتی ثبت نشده است.</div>';
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderChart(data){
 if(data.length<2){$('chart').innerHTML='<div class="empty">برای نمایش نمودار، دست‌کم دو بار وزن ثبت کن.</div>';return}
 const W=620,H=220,p=36,vals=data.map(e=>e.weight),min=Math.min(...vals)-1,max=Math.max(...vals)+1;
 const x=i=>p+i*(W-2*p)/(data.length-1),y=v=>H-p-(v-min)*(H-2*p)/(max-min);
 const points=data.map((e,i)=>`${x(i)},${y(e.weight)}`).join(' ');
 let circles=data.map((e,i)=>`<circle cx="${x(i)}" cy="${y(e.weight)}" r="4" fill="#173c35"><title>${e.date}: ${e.weight} kg</title></circle>`).join('');
 $('chart').innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="نمودار تغییرات وزن"><line x1="${p}" y1="${p}" x2="${W-p}" y2="${p}" stroke="#e2e6e1"/><line x1="${p}" y1="${H-p}" x2="${W-p}" y2="${H-p}" stroke="#e2e6e1"/><polyline points="${points}" fill="none" stroke="#39856b" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>${circles}<text x="${p}" y="20" font-size="12" fill="#68736e">${fa(max)} kg</text><text x="${p}" y="${H-8}" font-size="12" fill="#68736e">${fa(min)} kg</text><text x="${W-p}" y="${H-8}" text-anchor="end" font-size="11" fill="#68736e">${data[0].date}</text><text x="${W-p}" y="20" text-anchor="end" font-size="11" fill="#68736e">${data.at(-1).date}</text></svg>`;
}
$('entryForm').addEventListener('submit',e=>{
 e.preventDefault();const date=$('date').value;if(!date)return;
 const item={date,weight:$('weight').value?Number($('weight').value):null,food:$('food').value.trim(),calories:Number($('foodCalories').value)||0,activity:Number($('activity').value)||0,water:Number($('water').value)||0,notes:$('notes').value.trim()};
 entries=entries.filter(x=>x.date!==date);entries.push(item);save();render();
 $('weight').value='';$('food').value='';$('foodCalories').value='';$('activity').value='';$('water').value='';$('notes').value='';
 alert('اطلاعات ذخیره شد.');
});
window.removeEntry=date=>{if(confirm('این ثبت حذف شود؟')){entries=entries.filter(e=>e.date!==date);save();render()}};
$('exportBtn').addEventListener('click',()=>{
 const blob=new Blob([JSON.stringify(entries,null,2)],{type:'application/json'});
 const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='hamrah-vazn-data.json';a.click();URL.revokeObjectURL(url);
});
$('clearBtn').addEventListener('click',()=>{if(confirm('همه اطلاعات ذخیره‌شده پاک شود؟ این کار برگشت‌پذیر نیست.')){entries=[];save();render()}});
render();
</script>
</body>
</html>
